rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      // Role ko client se nahi badal sakte. Role sirf admin function se badlega.
      allow create: if request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // Permanent one-room claim: create-only, owned by the signed-in user.
    match /room_claims/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.ownerUid == userId
                    && request.resource.data.roomId is string
                    && existsAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
                    && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.hostUid == userId;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.hostUid
                    && existsAfter(/databases/$(database)/documents/room_claims/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/room_claims/$(request.auth.uid)).data.ownerUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/room_claims/$(request.auth.uid)).data.roomId == roomId;
      // Rooms are permanent: clients cannot delete them.
      allow delete: if false;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostUid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats'])
      );

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uid;
      }
    }

    match /families/{famId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.leaderUid;
      allow update, delete: if request.auth != null;
    }

    // Agent stock aur recharge log: sirf server (Cloud Functions) likhta hai
    match /agents/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /recharges/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /backups/{id} { allow read, write: if false; }
    match /user_backups/{id} { allow read, write: if false; }
    match /restores/{id} { allow read, write: if false; }

    match /bags/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /conversations/{cid} {
      allow read, update: if request.auth != null
                          && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
      }
    }
  }
}
